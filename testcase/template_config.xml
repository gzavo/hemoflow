<!-- HemoFlow solver configuration. Paths are relative to this file (absolute paths also work). -->
<simulation>
	<dt>1e-4</dt>	<!-- Time step [s]. Optional: without it, omega = 1 and dt = dx^2 / (6 nu). -->
	<cycle>1</cycle> <!-- Number of cardiac cycles to run; output is only written during the last cycle. -->
	<saveFrequency>0.016</saveFrequency> <!-- Output interval [s]. -->
	<outputDir>output</outputDir> <!-- Output directory, created if missing. -->
	<outputFields>velocity pressure</outputFields> <!-- Optional. Any of: velocity pressure stress viscosity (default: velocity pressure). -->
	<outputCoordinates>stl</outputCoordinates> <!-- Optional. Output grid in the coordinates of the input STL (stl, default; usually mm) or in m. Fields are SI. -->
	<sparse>true</sparse> <!-- Optional. true: only allocate blocks that contain the vessel; false: allocate the whole bounding box (default: true). -->
	<blockSize>24</blockSize>	<!-- Optional. Block size of the sparse decomposition [LB nodes] (default: 24). -->
	<!-- <checkpointFrequency>0.1</checkpointFrequency> --> <!-- Optional. Checkpoint interval [s]; restart with -c. -->
	<!-- <mode>murray</mode> --> <!-- Optional. murray | pzero. Without a mode, every opening needs an <opening_i> block. -->
</simulation>

<fluid> <!-- Optional. The defaults are for blood. -->
	<model>newtonian</model> <!-- Optional. newtonian (default) | carreau (Carreau-Yasuda, shear-thinning). -->
	<kinematicViscosity>3.22e-6</kinematicViscosity> <!-- [m^2/s], newtonian only -->
	<density>1055</density> <!-- [kg/m^3]. Scales pressure and stress; with carreau also nu = mu / density. -->
	<!-- carreau only: mu = muInf + (mu0 - muInf) (1 + (lambda gamma)^a)^((n - 1) / a). Defaults: blood after Cho and Kensey (1991).
	<mu0>0.056</mu0>         Zero-shear viscosity [Pa s]
	<muInf>0.00345</muInf>   Infinite-shear viscosity [Pa s]; sets the time step when dt is omitted
	<lambda>3.313</lambda>   Relaxation time [s]
	<n>0.3568</n>            Power-law index, 0 < n <= 1
	<a>2</a>                 Yasuda exponent, a > 0 (2: Carreau)
	-->
</fluid>

<geometry>
	<file>./geometry_file.npz</file> <!-- Geometry file from the preprocessor. -->

	<!-- Opening types: 1 - Velocity; 2 - Murray outlet; 3 - Pressure; 4 - Free outflow -->
	<!-- One block per opening: opening_0 ... opening_(N-1), N = number of openings in the geometry file. -->
	<opening_0>
		<name>Inlet</name> <!-- The name can be any string. -->
		<type>1</type> <!-- See types 1..4 above. -->
		<label>10</label> <!-- Label of the opening in the geometry file. -->
		<timeScaleFunction>./flowrate.txt</timeScaleFunction>  <!-- Waveform for this opening (optional). -->
		<parameter>0.1</parameter> <!-- Velocity: mean velocity [m/s] (parabolic profile, peak = 2x); pressure: gauge pressure [Pa]. Multiplied by the waveform. Negative velocities give an outflow. -->
	</opening_0>

	<opening_1>
		<name>Outlet 1 Murray</name> 
		<type>2</type> 
		<label>12</label>
		<timeScaleFunction></timeScaleFunction> <!-- Ignored on Murray and free-outflow openings. -->
		<parameter></parameter> <!-- Ignored on Murray openings: the flow rate is set every step by Murray's law. -->
	</opening_1>

	<opening_2>
		<name>Outlet 2 pressure</name> 
		<type>3</type> 
		<label>11</label>
		<timeScaleFunction></timeScaleFunction> <!-- Without a waveform the boundary value is constant. -->
		<parameter>0</parameter> <!-- [Pa] -->
	</opening_2>

</geometry>

<flowdiverter> <!-- Required if the geometry contains a flow diverter. -->
	<linCoeff>0</linCoeff> <!-- Darcy coefficient a [Pa s/m] of one voxel-thick porous layer; scaled per voxel by linearMultiplier of the geometry file. -->
	<quadCoeff>0</quadCoeff> <!-- Forchheimer coefficient b [Pa s^2/m^2] of one voxel-thick porous layer; scaled per voxel by quadraticMultiplier. -->
</flowdiverter>
