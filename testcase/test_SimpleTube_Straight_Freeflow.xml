<simulation>
	<dt>1e-4</dt>	<!-- Desired time step size [s]. This defines the balance between accuracy and computational cost. -->
	<blockSize>30</blockSize>	<!-- Target atomic block size for domain decomposition. (Side length, LB nodes) -->
	<outputDir>output</outputDir> <!-- Where to put the output files. Relative to this config file.-->
	<!-- Extended for better ParaView visibility -->
	<simLength>3.2</simLength> <!-- [s] -->
	<saveFrequency>0.016</saveFrequency> <!-- [s] -->
	<!-- The default value of HemoFlow is 1e-11 -->
	<!-- <convergenceTolerance>1e-10</convergenceTolerance> -->
</simulation>

<geometry>
	<file>./input/simple_tube_straight.npz</file> <!-- Geometry descriptor file location. Relative to this config file. -->

	<!-- Opening types: 1 - Velocity; 2 - Murray (velocity); 3- Pressure; 4 - Freeflow -->
	<!-- Create a separate tag for every opening. -->
	<opening_0>
		<name>Inlet</name>
		<type>1</type>
		<label>10</label>
		<timeScaleFunction>./input/simple_flowrate.txt</timeScaleFunction>  <!-- Scale function for this opening. -->
		<!-- [m/s] - Lower velocity for better ParaView visibility -->
		<parameter>0.1</parameter> <!-- [m/s] or [Pa]. The timeScaleFunction will scale this. On velocity openings it can be negative, it creates an outflow. -->
	</opening_0>

	<opening_1>
		<name>Outlet 0 Freeflow</name>
		<type>4</type>
		<label>11</label>
		<timeScaleFunction></timeScaleFunction>  <!-- Scale function for this opening. -->
		<parameter></parameter> <!-- [m/s] or [Pa]. The timeScaleFunction will scale this. On velocity openings it can be negative, it creates an outflow. -->
	</opening_1>

	<opening_2>
		<!-- Located on the side -->
		<name>Outlet 2 Pressure</name>
		<type>3</type>
		<label>12</label>
		<timeScaleFunction></timeScaleFunction>
		<parameter>0</parameter> <!-- [Pa] -->
	</opening_2>

</geometry>

<flowdiverter>
	<linCoeff>100</linCoeff>
	<quadCoeff>200</quadCoeff>
</flowdiverter>
