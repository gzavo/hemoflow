<simulation>
	<dt>1e-5</dt>	<!-- Desired stime step size [s]. This defines the balance between accuracy and computational cost. -->
	<blockSize>24</blockSize>	<!-- Block size of the sparse decomposition (side length, LB nodes). -->
	<outputDir>output</outputDir> <!-- Where to put the output files. Relative to this config file.-->
	<cycle>1</cycle> <!-- number of heart cycles to run; output is only written for the last cycle -->
	<saveFrequency>0.016</saveFrequency> <!-- [s] -->
	<mode>murray</mode> <!-- Boundary conditions set automatically, see below. -->
</simulation>

<geometry>
	<file>./input/vox_NAP180_ane_c.npz</file> <!-- Geometry descriptor file location. Relative to this config file. -->

	<!-- Opening types: 1 - Velocity; 2 - Murray (velocity); 3- Pressure; 4 - Freeflow -->
	<!-- Create a separate tag for every opening. -->
	<opening_0>
		<name>Inlet</name>
		<type>1</type>
		<label>10</label>
		<timeScaleFunction>./input/stationary.txt</timeScaleFunction>  <!-- Scale function for this opening. -->
		<parameter>0.364</parameter> <!-- [m/s] or [Pa]. The timeScaleFunction will scale this. On velocity openings it can be negative, it creates an outflow. -->
	</opening_0>
	
	<!-- Murray mode: label 10 is the velocity inlet (parameters above), label 11 (the smallest outlet)
	     a 0 Pa pressure outlet, and all other openings are Murray outlets. No other opening blocks are needed. -->
</geometry>

<flowdiverter>
	<linCoeff>100</linCoeff>
	<quadCoeff>200</quadCoeff>
</flowdiverter>
